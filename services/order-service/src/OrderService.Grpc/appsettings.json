{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "OrderDb": "Server=127.0.0.1,1433;Database=mini_k8s_local;User Id=sa;Password=admin@123456;Encrypt=True;TrustServerCertificate=True;Connection Timeout=15;"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "CommandTimeoutSeconds": 5,
    "MigrationMaxRetries": 15,
    "MigrationRetryDelayMs": 2000,
    "DbContextPoolSize": 128
  },
  "Kafka": {
    "BootstrapServers": "127.0.0.1:19092",
    "Topic": "order.created",
    "ConsumerGroupId": "order-service-workers",
    "LingerMs": 5,
    "BatchSizeBytes": 65536,
    "EnableBackgroundWorkers": true
  },
  "Outbox": {
    "BatchSize": 100,
    "PollIntervalMs": 200,
    "MaxRetries": 5
  },
  "WebhookClient": {
    "Address": "http://127.0.0.1:5002",
    "TimeoutSeconds": 10
  },
  "Grpc": {
    "Port": 5001
  },
  "Health": {
    "Port": 8081
  }
}
